# Keep Docker build context small; model artifacts now come from object storage.
.gcloudignore
.git/
.gitignore
.env
.vscode/
.firebase/
gha-creds-*.json
serviceAccountKey.json
node_modules/
__pycache__/
.venv/
venv/
tox_env/
*.log
*.tmp
frontend/
notebooks/
outputs/
results/
temp_out.json
models/
# Local documents / photos are not needed in the backend image.
documents photos/
# Keep MolRAG retrieval data in image while excluding the rest of test fixtures.
test_data/**
!test_data/
!test_data/reference_panel.csv
!test_data/screening_library.csv
