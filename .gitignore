# Python cache and build outputs
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
*$py.class
build/
dist/

# Virtual environments
.venv/
venv/
env/
.conda/
tox_env/
.venv311/
# Jupyter
.ipynb_checkpoints/

# Node package managers and build outputs
node_modules/
**/node_modules/
frontend/dist/
legacy/**/dist/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and secrets
.env
.env.*
!.env.example
serviceAccountKey.json
gha-creds-*.json

# Firebase local artifacts
.firebase/
firestore-debug.log
ui-debug.log

# Per-developer and per-environment frontend config (untracked 2026-09-03;
# the previous copies held only VITE_API_BASE_URL, no credentials).
frontend/.env.local
frontend/.env.production

# Local code-intelligence index (machine-local)
.codegraph/

# Benchmark per-sample dumps are regenerated by run_benchmark.py; only the
# summary report, which carries the provenance, is tracked.
benchmarks/results/*_per_sample.json

# Workspace-generated artifacts
results/
outputs/
logs/
temp_out.json
output.json

# Serialized artifacts commonly regenerated locally
*.pkl
*.pt
*.pth
*.h5
*.hdf5

# Datasets and local-only content
data/
documents photos/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Archived prototypes may create their own local dependencies
legacy/
legacy/**/node_modules/
notebooks/

# Keep committed model metadata and selected runtime assets explicit.
models/**/*.json
models/**/*.txt
!models/dualhead_model_ranking.csv
!models/pretrained_2head_herg_chemberta_model/
!models/pretrained_2head_herg_chemberta_model/**
!models/pretrained_2head_herg_chemberta_model/base_model/**

/.agents/skills
skills-lock.json

# Generated model artifacts
models/**/*.pt
models/**/*.pth
models/**/*.npy
models/**/*.npz

# Checkpoints and calibration metadata kept on purpose (decision 2026-09-03:
# retain every model checkpoint and its logic). Declared explicitly so the
# ignore rules above no longer contradict what is actually tracked.
!models/pretrained_2head_herg_chemberta_model/**
!models/pretrained_2head_herg_chemberta_model/base_model/**
!models/smilesgnn_model/best_model.pt
!models/smilesgnn_model/smilesgnn_model_metrics.txt
!models/smilesgnn_herg_exp_model/**
!models/tox21_gatv2_model/best_model.pt
!models/tox21_gatv2_model/*.json
!models/tox21_gatv2_model/*.txt

# Generated figures
assets/*.png
benchmark/**/*.png

# Experiment outputs
results/
