# Python cache and build outputs
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
*$py.class
build/
dist/

# Virtual environments
.venv/
venv/
env/
.conda/
tox_env/
.venv311/
# Jupyter
.ipynb_checkpoints/

# Node package managers and build outputs
node_modules/
**/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
legacy/**/dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and secrets
.env
.env.*
!.env.example
.artifacts/
backups/
.data/
.cache/

# Eval runner output (the task set, fixtures and graders are tracked; runs are not)
backend/control/evals/manifests/manifest-*.json
backend/control/evals/manifests/results-*.json
backend/control/evals/manifests/_work/
# Captured from a running pinned OpenCode binary by snapshot_opencode_contract.py;
# commit it deliberately once captured (it is the pinned contract), so it is not
# ignored — listed here only as a reminder of where it lands.
# toxagent-control/toxagent/harness/adapters/opencode_v1_contract.json
serviceAccountKey.json
gha-creds-*.json

# Firebase local artifacts
.firebase/
firestore-debug.log
firebase-debug.log
ui-debug.log

# Per-developer and per-environment frontend config (untracked 2026-09-03;
# the previous copies held only VITE_API_BASE_URL, no credentials).
frontend/.env.local
frontend/.env.production

# Local code-intelligence index (machine-local)
.codegraph/

# Benchmark per-sample dumps are regenerated by run_benchmark.py; only the
# summary report, which carries the provenance, is tracked.
backend/predictor/evals/benchmark/results/*_per_sample.json

# Workspace-generated artifacts
results/
!backend/predictor/evals/benchmark/results/
!backend/predictor/evals/benchmark/results/operational-baseline-v1.json
outputs/
logs/
temp_out.json
output.json

# Serialized artifacts commonly regenerated locally
*.pkl
*.pt
*.pth
*.h5
*.hdf5

# Datasets and local-only content
data/
documents photos/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Archived prototypes may create their own local dependencies
legacy/
legacy/**/node_modules/
notebooks/

/.agents/skills
skills-lock.json

# Generated figures
assets/*.png
benchmark/**/*.png

# Experiment outputs
results/
!backend/predictor/evals/benchmark/results/
!backend/predictor/evals/benchmark/results/operational-baseline-v1.json
.data/opencode-auth/
.data/opencode-workspaces/
