# ToxAgent local evaluation stack. `./bin/toxagent setup` copies this file and
# fills the generated values below. Do not commit the resulting `.env` file.
TOXAGENT_ENV=development
TOXAGENT_STATIC_TOKENS=
TOXAGENT_CAPABILITY_SECRET=

# Browser address. The setup command prints the generated access token.
FRONTEND_PORT=8088

# CPU is the supported default. GPU is opt-in via infra/compose/gpu.yaml.
TOXAGENT_ACCELERATOR=cpu
TOXPRED_DEVICE=cpu
TOXPRED_TORCH_VARIANT=cpu
TOXOCR_DEVICE=cpu
TOXOCR_TORCH_VARIANT=cpu

# Predictor artifacts already in this checkout. For an artifact registry, set
# MODEL_ARTIFACTS_URI; otherwise leave it blank and keep this local path.
MODEL_ARTIFACTS_URI=
TOXPRED_MODELS_HOST_PATH=./models

# MolScribe is provisioned by `./bin/toxagent setup` into this ignored path.
TOXOCR_CHECKPOINT_HOST_PATH=./.artifacts/toxocr
TOXOCR_CHECKPOINT_SHA256=64f4443d6f5a2bc594d5f0b5acdd48b8e1d13d699d08e2456b54b352ffe99fce

# Optional external OpenCode runtime. Do not set these for the default stack;
# use `-f infra/compose/external-opencode.yaml` after configuring a runtime.
TOXAGENT_OPENCODE_URL=
TOXAGENT_OPENCODE_DIRECTORY=
TOXAGENT_MCP_RUNTIME_URL=
TOXAGENT_PROVIDER_ID=
TOXAGENT_MODEL_ID=
