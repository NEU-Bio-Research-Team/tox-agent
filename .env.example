# ToxAgent local evaluation stack. `./bin/toxagent setup` copies this file and
# fills the generated values below. Do not commit the resulting `.env` file.
TOXAGENT_ENV=development
TOXAGENT_STATIC_TOKENS=
TOXAGENT_CAPABILITY_SECRET=

# Who a product user is. These three go together — issuer, audience and the
# provider's published key set — and production will not start without them.
# The audience is not optional padding: without it the server accepts a token
# the same provider minted for a different service, which is a valid token
# belonging to somebody else's API.
#
# `TOXAGENT_CAPABILITY_SECRET` above is not an alternative to these. It signs
# the run-scoped tokens the runtime carries, which is a different trust domain;
# user authentication used to fall back to that key and no longer can.
TOXAGENT_OIDC_ISSUER=
TOXAGENT_OIDC_AUDIENCE=
TOXAGENT_OIDC_JWKS_URL=

# Browser address. The setup command prints the generated access token.
FRONTEND_PORT=8088

# Where the control plane may send a model endpoint URL somebody typed into
# Settings. `local` allows private addresses, which is correct for
# self-hosting: your own Ollama or vLLM is on loopback or the LAN. A
# multi-user deployment must set `hosted`, where a private address is never a
# legitimate model endpoint and a request to one would be forgery using the
# server's network position. Production refuses to start on `local`.
TOXAGENT_EGRESS_POLICY=local

# CPU is the supported default. GPU is opt-in via devops/compose/gpu.yaml.
TOXAGENT_ACCELERATOR=cpu
TOXPRED_DEVICE=cpu
TOXPRED_TORCH_VARIANT=cpu
TOXOCR_DEVICE=cpu
TOXOCR_TORCH_VARIANT=cpu

# Predictor artifacts already in this checkout. For an artifact registry, set
# MODEL_ARTIFACTS_URI; otherwise leave it blank and keep this local path.
MODEL_ARTIFACTS_URI=
TOXPRED_MODELS_HOST_PATH=./.data/models

# MolScribe is provisioned by `./bin/toxagent setup` into this ignored path.
TOXOCR_CHECKPOINT_HOST_PATH=./.artifacts/toxocr
TOXOCR_CHECKPOINT_SHA256=64f4443d6f5a2bc594d5f0b5acdd48b8e1d13d699d08e2456b54b352ffe99fce

# Optional external OpenCode runtime. Do not set these for the default stack;
# use `-f devops/compose/external-opencode.yaml` after configuring a runtime.
TOXAGENT_OPENCODE_URL=
TOXAGENT_OPENCODE_DIRECTORY=
TOXAGENT_MCP_RUNTIME_URL=
TOXAGENT_PROVIDER_ID=
TOXAGENT_MODEL_ID=
