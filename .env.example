# ============================================================
# PREDICT APIs - AWS Cloud (primary) + GCP Cloud (fallback)
# ============================================================

# PRIMARY: AWS EC2/ECS running model_server/
MODEL_SERVER_URL_AWS=https://your-ec2-ip-or-domain:8000

# FALLBACK: GCP Cloud Run running model_server/ (current deployment)
# Leave blank if you do not have a separate fallback yet.
MODEL_SERVER_URL_GCP=https://tox-model-server-xxxxxxxx-uc.a.run.app

# Timeouts
MODEL_SERVER_TIMEOUT=240
MODEL_SERVER_HEALTH_TIMEOUT=12

# ============================================================
# AGENT APIs - Google ADK / Gemini
# ============================================================
GEMINI_MODEL=gemini-2.5-flash
AGENT_MODEL_FAST=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================================
# DEPRECATED - backward compatibility only
# MODEL_SERVER_URL is used only when both AWS and GCP URLs are empty
# ============================================================
# MODEL_SERVER_URL=http://127.0.0.1:8000