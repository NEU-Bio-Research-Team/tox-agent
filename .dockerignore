# Keep Docker build context/image lean (backend only).
# Model artifacts now come from object storage at runtime.

.gcloudignore
.git
.git/
.gitignore
.env
.vscode/
.firebase/
gha-creds-*.json
serviceAccountKey.json

# Node / frontend
node_modules/
**/node_modules/
**/dist/
# The root context builds the predictor image only; the frontend has its own
# context (frontend/deploy/Dockerfile) and never belongs in this one.
frontend/
# Untracked local leftovers that must never enter the image.
legacy/
notebooks/
.pytest_cache/
tests/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Local envs / artifacts
.venv/
tox_env/
.cache/
.artifacts/
.data/

# Not needed for backend runtime
docs/
outputs/
results/
logs/
benchmark/
.agents/
.codegraph/
data/
documents photos/
*.pptx
package.json
package-lock.json

# Misc
*.log
*.tmp
temp_out.json
output.json
