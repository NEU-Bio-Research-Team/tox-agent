# Keep Docker build context/image lean (backend only).
# Model artifacts now come from object storage at runtime.

.gcloudignore
.git
.git/
.gitignore
.env
.vscode/
.firebase/
gha-creds-*.json
serviceAccountKey.json

# Node / frontend
node_modules/
**/node_modules/
**/dist/
# frontend/ was removed from the repository by the predictor-only refactor, but
# an untracked node_modules and dist may still sit on a developer's disk. Keep
# them out of the build context.
frontend/
# Untracked local leftovers that must never enter the image.
legacy/
notebooks/
.pytest_cache/
tests/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Local envs / artifacts
.venv/
tox_env/

# Not needed for backend runtime
docs/
outputs/
results/
logs/
models/
benchmark/
benchmarks/
.agents/
.codegraph/
data/
test_data/
documents photos/
*.pptx
package.json
package-lock.json

# Misc
*.log
*.tmp
temp_out.json
output.json
