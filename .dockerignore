# Keep Docker build context/image lean (backend only).
# Model artifacts now come from object storage at runtime.

.gcloudignore
.git
.git/
.gitignore
.env
.vscode/
.firebase/
gha-creds-*.json
serviceAccountKey.json

# Node / frontend
node_modules/
frontend/
legacy/
tests/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Local envs / artifacts
.venv/
tox_env/

# Not needed for backend runtime
notebooks/
docs/
outputs/
results/
logs/
models/
benchmark/
benchmarks/
.agents/
.codegraph/
data/
test_data/
documents photos/
*.pptx
package.json
package-lock.json

# Misc
*.log
*.tmp
temp_out.json
output.json
