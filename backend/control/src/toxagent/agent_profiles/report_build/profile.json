      "permission": {
        "*": "deny",
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "shell": "deny",
        "task": "deny",
        "subagent": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "execute": "deny",
        "toxagent_*": "allow"
      }
    }
  }
}
