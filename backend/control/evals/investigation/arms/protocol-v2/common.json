{
  "about": "What B, C and D share under protocol v2 (#50): one output schema, one hard validator, one bounded semantic review, one budget, and the same snapshots, screenings, corpus and backbone. Each arm file adds only what it is testing.",
  "protocol": "investigation-protocol-v2",
  "family": "toxagent",
  "adapter": "toxagent",
  "budget_preset": "investigator-pilot-v1",
  "required_flags": {
    "answer_draft_v2": true,
    "evidence_full_text_v1": true,
    "activity_replay_v1": true,
    "claim_reviewer_v1": true,
    "release_gate_v1": true,
    "typed_stop_v1": true,
    "scientific_case_v1": false,
    "scientific_skills_v1": false,
    "fixed_workflow_v1": false
  },
  "skills_mode": "off",
  "same_across_arms": [
    "runtime.provider_id",
    "runtime.model_id",
    "budget.preset",
    "providers.research_provider",
    "providers.research_snapshot",
    "providers.research_corpus",
    "providers.activity_replay"
  ]
}
