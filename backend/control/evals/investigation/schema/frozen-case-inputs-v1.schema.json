{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frozen-case-inputs-v1",
  "title": "Everything a system is given for one case, and nothing it is graded against",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "workflow_context",
    "subject",
    "artifacts",
    "evidence",
    "contracts",
    "turns",
    "provenance",
    "dependency_groups"
  ],
  "properties": {
    "schema_version": {
      "const": "frozen-case-inputs-v1"
    },
    "case_id": {
      "type": "string"
    },
    "workflow_context": {
      "enum": [
        "toxicity_only",
        "activity_guided"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "identity"
      ],
      "properties": {
        "subject_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "analysis",
                "activity_screening"
              ]
            },
            "analysis_ref": {
              "type": "string",
              "pattern": "^ana_[0-9a-f]{32}$",
              "description": "A frozen analysis the deployment's replay file holds."
            },
            "screening_id": {
              "type": "string",
              "pattern": "^scr_[0-9a-f]{32}$"
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_smiles"
          ],
          "properties": {
            "canonical_smiles": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": [
                "object",
                "null"
              ]
            },
            "assay_context": {
              "type": [
                "string",
                "null"
              ]
            },
            "name_disclosed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "content_sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "screening",
              "toxicity_snapshot",
              "frozen_analysis"
            ]
          },
          "ref": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stage_status": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "snapshot",
        "full_text"
      ],
      "properties": {
        "provider": {
          "enum": [
            "snapshot",
            "corpus",
            "none"
          ]
        },
        "snapshot": {
          "type": [
            "object",
            "null"
          ]
        },
        "full_text": {
          "type": [
            "object",
            "null"
          ]
        },
        "access_states": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "full_text_retrieved",
              "access_failed",
              "abstract_only",
              "not_held"
            ]
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "required": [
        "model",
        "policy",
        "parser",
        "tool_contract"
      ]
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "subject_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "analysis",
                  "activity_screening"
                ]
              },
              "analysis_ref": {
                "type": "string",
                "pattern": "^ana_[0-9a-f]{32}$",
                "description": "A frozen analysis the deployment's replay file holds."
              },
              "screening_id": {
                "type": "string",
                "pattern": "^scr_[0-9a-f]{32}$"
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "add_context",
                    "attach_evidence_ref",
                    "switch_subject"
                  ]
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "scope": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "ref": {
                  "type": "string",
                  "pattern": "^(pmid|doi|pmcid|evidence):.+$"
                },
                "subject_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "analysis",
                        "activity_screening"
                      ]
                    },
                    "analysis_ref": {
                      "type": "string",
                      "pattern": "^ana_[0-9a-f]{32}$",
                      "description": "A frozen analysis the deployment's replay file holds."
                    },
                    "screening_id": {
                      "type": "string",
                      "pattern": "^scr_[0-9a-f]{32}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "synthetic_engineering_fixture",
            "pending_sme",
            "sme_verified"
          ]
        },
        "admission_status": {
          "enum": [
            "admitted",
            "not_admitted",
            "not_applicable"
          ]
        },
        "note": {
          "type": "string"
        },
        "sair_status": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ]
        }
      }
    },
    "dependency_groups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compounds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
