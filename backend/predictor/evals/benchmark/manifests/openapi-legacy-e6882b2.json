{
  "components": {
    "schemas": {
      "AgentAnalyzeRequest": {
        "properties": {
          "binary_tox_model": {
            "default": "pretrained_2head_herg_chemberta_model",
            "description": "Model key for binary toxicity prediction (e.g. dualhead_ensemble6_simple, dualhead_ensemble3_weighted, dualhead_ensemble3_simple, dualhead_ensemble5_simple, pretrained_2head_herg_chemberta_model)",
            "title": "Binary Tox Model",
            "type": "string"
          },
          "clinical_threshold": {
            "default": 0.35,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Clinical Threshold",
            "type": "number"
          },
          "include_agent_events": {
            "default": true,
            "description": "Include agent/tool calling event trace for debugging",
            "title": "Include Agent Events",
            "type": "boolean"
          },
          "inference_backend": {
            "default": "xsmiles",
            "description": "Inference backend for screening: xsmiles, chemberta, pubchem, or molformer",
            "title": "Inference Backend",
            "type": "string"
          },
          "language": {
            "default": "vi",
            "description": "Report language: vi or en",
            "title": "Language",
            "type": "string"
          },
          "max_literature_results": {
            "default": 5,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Literature Results",
            "type": "integer"
          },
          "mechanism_threshold": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Mechanism Threshold",
            "type": "number"
          },
          "molrag_enabled": {
            "default": false,
            "description": "Enable MolRAG retrieval + reasoning augmentation in screening output.",
            "title": "Molrag Enabled",
            "type": "boolean"
          },
          "molrag_min_similarity": {
            "default": 0.15,
            "description": "Minimum Tanimoto similarity threshold for MolRAG retrieval.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Molrag Min Similarity",
            "type": "number"
          },
          "molrag_top_k": {
            "default": 5,
            "description": "Top-k similar molecules retrieved for MolRAG evidence.",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Molrag Top K",
            "type": "integer"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional session id. If omitted, a new one is generated.",
            "title": "Session Id"
          },
          "smiles": {
            "description": "SMILES string",
            "title": "Smiles",
            "type": "string"
          },
          "tox_type_model": {
            "default": "tox21_ensemble_3_best",
            "description": "Model key for toxicity-type prediction (e.g. dualhead_ensemble6_simple, dualhead_ensemble3_weighted, dualhead_ensemble3_simple, dualhead_ensemble5_simple, tox21_pretrained_gin_model, tox21_gatv2_model)",
            "title": "Tox Type Model",
            "type": "string"
          },
          "user_id": {
            "default": "default_user",
            "description": "Logical user id",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "smiles"
        ],
        "title": "AgentAnalyzeRequest",
        "type": "object"
      },
      "AgentAnalyzeResponse": {
        "properties": {
          "adk_available": {
            "title": "Adk Available",
            "type": "boolean"
          },
          "agent_events": {
            "items": {
              "$ref": "#/components/schemas/AgentEventRecord"
            },
            "title": "Agent Events",
            "type": "array"
          },
          "chat_session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Report-chat session id used by /agent/chat for follow-up QA.",
            "title": "Chat Session Id"
          },
          "evidence_qa_result": {
            "additionalProperties": true,
            "description": "Evidence quality payload used by report chat for confidence calibration.",
            "title": "Evidence Qa Result",
            "type": "object"
          },
          "final_report": {
            "additionalProperties": true,
            "title": "Final Report",
            "type": "object"
          },
          "final_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Text"
          },
          "runtime_mode": {
            "default": "adk",
            "description": "Runtime path used by /agent/analyze: adk or deterministic_fallback",
            "title": "Runtime Mode",
            "type": "string"
          },
          "runtime_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional note describing fallback cause when runtime_mode is deterministic_fallback",
            "title": "Runtime Note"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "state_keys": {
            "items": {
              "type": "string"
            },
            "title": "State Keys",
            "type": "array"
          },
          "validation_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validation Status"
          }
        },
        "required": [
          "session_id",
          "adk_available"
        ],
        "title": "AgentAnalyzeResponse",
        "type": "object"
      },
      "AgentChatRequest": {
        "properties": {
